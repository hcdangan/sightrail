{
  "name": "sightrail",
  "private": true,
  "version": "1.3.0",
  "description": "Sightrail - a full-stack workbench that showcases every Ultralytics YOLO mode and task behind a modern web UI.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "npm@10",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "preview": "npm --workspace apps/web run preview",
    "lint": "npm --workspace apps/web run lint",
    "lint:api": "node scripts/run-api-lint.mjs",
    "typecheck": "npm --workspace apps/web run typecheck",
    "typecheck:api": "node scripts/run-api-types.mjs",
    "test": "npm --workspace apps/web run test && npm run test:api",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:web": "npm --workspace apps/web run test",
    "version:check": "node scripts/check-version.mjs",
    "license:report": "node scripts/license-report.mjs",
    "verify": "npm run version:check && npm run typecheck && npm run typecheck:api && npm run lint && npm run lint:api && npm run build && npm run test:web && npm run test:api",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
