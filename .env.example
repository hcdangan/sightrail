# =============================================================================
#  Sightrail - environment configuration
# =============================================================================
#  Copy this file to `.env` in the repository root and edit it:
#
#      cp .env.example .env          # macOS / Linux
#      copy .env.example .env        # Windows
#
#  Every value here overrides the defaults in
#  apps/api/sightrail/config.py. Restart the API after editing.
# =============================================================================


# =============================================================================
#  >>>>>>>>>>>>>>>>>>>>>>  COMPUTE DEVICE  <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
# -----------------------------------------------------------------------------
#  Uncomment exactly ONE of the three lines below, then restart the API.
#  This is the only setting most people ever need to change.
# -----------------------------------------------------------------------------

# Run on the CPU. Always works, no drivers required. Slowest option.
SIGHTRAIL_DEVICE=cpu

# Run on an NVIDIA GPU via CUDA. Requires a CUDA build of PyTorch - see the
# "GPU acceleration" section of README.md for the one-line install.
# SIGHTRAIL_DEVICE=cuda:0

# Run on a Hailo accelerator (Hailo-8 / 8L / 10H / 15H) through HailoRT.
# Requires a `.hef` model - see SIGHTRAIL_HAILO_MODEL below.
# SIGHTRAIL_DEVICE=hailo

# 'auto' picks CUDA when available, then MPS (Apple), then the Hailo runtime,
# then CPU. Use it if you would rather not pin a device.
# SIGHTRAIL_DEVICE=auto


# =============================================================================
#  Hailo accelerator (Raspberry Pi + Hailo-8L AI HAT, and Hailo-8/15 boards)
# =============================================================================
# Hailo inference needs a compiled HEF model, not a .pt checkpoint. Point this
# at either a single .hef file or a `*_hailo_model/` directory produced by
# Export mode (format = hailo). Leave empty to auto-discover the first HEF
# under storage/weights.
SIGHTRAIL_HAILO_MODEL=

# Hailo architecture used when exporting to HEF:
#   hailo8l  - Raspberry Pi AI HAT+ / AI Kit (13 TOPS)  <- Pi default
#   hailo8   - Hailo-8 M.2 / PCIe (26 TOPS)
#   hailo10h - Hailo-10H
#   hailo15h - Hailo-15H
#   hailo15l - Hailo-15L
SIGHTRAIL_HAILO_ARCH=hailo8l

# Where the Hailo Dataflow Compiler lives (only needed for *exporting* to HEF).
# The venv is activated before the compiler runs, so its Python bindings and
# HailoRT wheel are importable. Leave empty to skip.
SIGHTRAIL_HAILO_DFC_PYTHON=


# =============================================================================
#  Server
# =============================================================================
SIGHTRAIL_HOST=127.0.0.1
SIGHTRAIL_PORT=8000
SIGHTRAIL_LOG_LEVEL=info


# =============================================================================
#  Inference defaults
# =============================================================================
SIGHTRAIL_DEFAULT_MODEL=yolo11n.pt
SIGHTRAIL_DEFAULT_CONFIDENCE=0.25
SIGHTRAIL_DEFAULT_IOU=0.7
SIGHTRAIL_DEFAULT_IMGSZ=640
SIGHTRAIL_MAX_UPLOAD_MB=512
SIGHTRAIL_MAX_BATCH_SIZE=32
SIGHTRAIL_MODEL_CACHE_SIZE=6


# =============================================================================
#  Jobs and storage
# =============================================================================
SIGHTRAIL_MAX_CONCURRENT_JOBS=1
SIGHTRAIL_JOB_RETENTION_SECONDS=3600

# SIGHTRAIL_STORAGE_ROOT=./storage

# Extra directories the API may read inference sources from, comma separated.
# The storage root and the repository root are always allowed.
# SIGHTRAIL_EXTRA_SOURCE_ROOTS=D:/datasets,E:/images


# =============================================================================
#  Feature flags
# =============================================================================
SIGHTRAIL_ALLOW_DATASET_DOWNLOADS=true
SIGHTRAIL_ALLOW_HEAVY_EXPORT=true

# Comma-separated browser origins allowed to call the API.
# SIGHTRAIL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
